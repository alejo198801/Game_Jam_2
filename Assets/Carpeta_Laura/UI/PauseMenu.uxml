                    <ui:Label text="PAUSA" name="pause-title" style="font-size: 32px; color: rgb(48, 37, 29); margin-bottom: 24px; -unity-text-align: middle-center; -unity-font-definition: url(&quot;project://database/Assets/Carpeta_Laura/Fonts/IBMPlexMono-Medium.ttf?fileID=12800000&amp;guid=18a82dc14d199cc4daddc8ce4b0a6aa7&amp;type=3#IBMPlexMono-Medium&quot;);"/>
                    <ui:Button text="CONTINUAR" name="resume-button" class="ui-feedback" style="height: 52px; font-size: 22px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; -unity-text-align: middle-left; -unity-font-definition: url(&quot;project://database/Assets/Carpeta_Laura/Fonts/IBMPlexMono-Medium.ttf?fileID=12800000&amp;guid=18a82dc14d199cc4daddc8ce4b0a6aa7&amp;type=3#IBMPlexMono-Medium&quot;);"/>

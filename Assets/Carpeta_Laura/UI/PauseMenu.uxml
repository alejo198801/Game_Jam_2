    <ui:VisualElement name="menu-root" style="flex-grow: 1; justify-content: center; align-items: flex-start; background-image: none; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.549); display: flex; overflow: visible;">
        <ui:VisualElement name="dossier-root" style="flex-grow: 1; position: absolute; left: 19%; top: 18%; width: 560px; height: 580px;">

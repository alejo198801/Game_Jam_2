                        <ui:VisualElement name="movement-icon" picking-mode="Ignore" style="background-image: url(&quot;project://database/Assets/Carpeta_Laura/UI/Dossier/wasd.png?fileID=2800000&amp;guid=f59b3b2b4b8f0904795930a659d7b0e1&amp;type=3#wasd&quot;);" class="control-icon" />
                        <ui:Label text="MOVERSE" name="movement-description" class="control-description" />
                    </ui:VisualElement>
                    <ui:VisualElement name="interaction-row" class="control-row">
                        <ui:VisualElement name="interaction-icon" picking-mode="Ignore" style="background-image: url(&quot;project://database/Assets/Carpeta_Laura/UI/Dossier/Epickup.png?fileID=2800000&amp;guid=1df53d16705941a479390049d24c699d&amp;type=3#Epickup&quot;);" class="control-icon" />
                        <ui:Label text="INTERACTUAR /&#10;MOVER OBJETOS" name="interaction-description" class="control-description" />
                    </ui:VisualElement>
                    <ui:VisualElement name="camera-row" class="control-row">
                        <ui:VisualElement name="camera-icon" picking-mode="Ignore" style="background-image: url(&quot;project://database/Assets/Carpeta_Laura/UI/Dossier/mouse.png?fileID=2800000&amp;guid=2b8e9a66b4978bb45887f74d6c98eb88&amp;type=3#mouse&quot;);" class="control-icon" />
                        <ui:Label text="GIRAR CÁMARA" name="camera-description" class="control-description" />
                    </ui:VisualElement>
                    <ui:Button text="← VOLVER" name="controls-back-button" class="ui-feedback back-button" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="dossier-pocket" picking-mode="Ignore" style="flex-grow: 1; position: absolute; left: 12px; bottom: 13px; right: 12px; height: 180px; background-image: url(&quot;project://database/Assets/Carpeta_Laura/UI/Dossier/bolsillomenu.png?fileID=2800000&amp;guid=2e24e0b2d7d9472479f5a421d3962437&amp;type=3#bolsillomenu&quot;); background-size: 100% 300%;" />
            <ui:VisualElement name="dossier-tabs" style="flex-grow: 1; position: absolute; left: 28px; right: 28px; top: -24px; height: 64px; flex-direction: row;">

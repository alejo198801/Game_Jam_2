<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Carpeta_Laura/UI/MainMenu.uss?fileID=7433441132597879392&amp;guid=45d6b30ef85949f4c876fff1fb51cf71&amp;type=3#MainMenu"/>
    <ui:VisualElement name="menu-root" style="flex-grow: 1; justify-content: center; align-items: flex-start; background-image: url(&quot;project://database/Assets/Carpeta_Laura/UI/fondoMenu.png?fileID=2800000&amp;guid=32066eedcae4a6b4ca091a0593f9dc30&amp;type=3#fondoMenu&quot;); width: 100%; height: 100%;">
        <ui:Label text="DOS MUNDOS" name="game-title" style="font-size: 80px; color: rgb(234, 216, 183); -unity-font-style: normal; margin-bottom: 0%; position: absolute; left: 16%; bottom: auto; margin-right: 0%; margin-top: 0%; margin-left: 0%; padding-bottom: 0; padding-top: 0; padding-right: 0; padding-left: 0; top: 23%;"/>
        <ui:VisualElement name="menu-panel" style="flex-grow: 0; width: 440px; margin-left: 0; padding-right: 68px; padding-left: 68px; padding-bottom: 28px; padding-top: 80px; background-color: rgba(191, 139, 96, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgba(128, 91, 61, 0); border-right-color: rgba(128, 91, 61, 0); border-top-color: rgba(128, 91, 61, 0); border-bottom-color: rgba(128, 91, 61, 0); position: absolute; left: 19%; bottom: auto; height: 440px; background-image: url(&quot;project://database/Assets/Carpeta_Laura/UI/carpetaMenu2.0.png?fileID=2800000&amp;guid=87de85b9b0b1aa142a7a49c963032970&amp;type=3#carpetaMenu2.0&quot;); top: 40%;">
            <ui:Label text="ARCHIVO INTERNO · ACCESO RESTRINGIDO" name="file-header" style="color: rgb(87, 64, 47); font-size: 12px; margin-bottom: 12px; display: flex; height: 18px; width: 251px; white-space: normal; left: 6px;"/>
            <ui:Button text="JUGAR" name="play-button" class="menu-button"/>
            <ui:Button text="OPCIONES" name="options-button" class="menu-button"/>
            <ui:Button text="CRÉDITOS" name="credits-button" class="menu-button"/>
            <ui:Button text="SALIR" name="quit-button" class="menu-button" style="border-bottom-width: 0;"/>
        </ui:VisualElement>
        <ui:VisualElement name="options-panel" style="flex-grow: 1; position: absolute; left: 19%; bottom: auto; width: 620px; padding-top: 32px; padding-right: 32px; padding-bottom: 32px; padding-left: 32px; background-color: rgba(232, 225, 207, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgba(166, 157, 137, 0); border-right-color: rgba(166, 157, 137, 0); border-top-color: rgba(166, 157, 137, 0); border-bottom-color: rgba(166, 157, 137, 0); background-image: url(&quot;project://database/Assets/Carpeta_Laura/UI/hoja-options.png?fileID=2800000&amp;guid=d35193a12e0a3534f9555059115173fd&amp;type=3#hoja-options&quot;); display: none; top: 34%;">
            <ui:Label text="CONFIGURACIÓN" name="options-title" style="font-size: 32px; color: rgb(48, 37, 29); margin-bottom: 24px; -unity-text-align: middle-center;"/>
            <ui:Slider label="Volumen general" value="42" high-value="100" name="master-volume-slider" style="margin-bottom: 16px;"/>
            <ui:Slider label="Música" value="42" high-value="100" name="music-volume-slider" style="margin-bottom: 16px;"/>
            <ui:Slider label="Efectos" value="42" high-value="100" name="sfx-volume-slider" style="margin-bottom: 16px;"/>
            <ui:Slider label="Sensibilidad del mouse" value="1" high-value="3" name="sensitivity-slider" low-value="0.1" style="margin-bottom: 16px;"/>
            <ui:Button text="← VOLVER" name="options-back-button" style="height: 42px; font-size: 22px; color: rgb(48, 37, 29); background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; -unity-text-align: middle-left;"/>
        </ui:VisualElement>
        <ui:VisualElement name="credits-panel" style="flex-grow: 1; position: absolute; left: 19%; bottom: auto; width: 620px; padding-top: 32px; padding-right: 32px; padding-bottom: 32px; padding-left: 32px; background-color: rgba(232, 225, 207, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgba(166, 157, 137, 0); border-right-color: rgba(166, 157, 137, 0); border-top-color: rgba(166, 157, 137, 0); border-bottom-color: rgba(166, 157, 137, 0); background-image: url(&quot;project://database/Assets/Carpeta_Laura/UI/hoja-options.png?fileID=2800000&amp;guid=d35193a12e0a3534f9555059115173fd&amp;type=3#hoja-options&quot;); display: none; top: 34%;">
            <ui:Label text="CRÉDITOS" name="credits-title" style="font-size: 32px; color: rgb(48, 37, 29); margin-bottom: 24px; -unity-text-align: middle-center;"/>
            <ui:Label text="Equipo: [Nombre del equipo]&#10;&#10;Programación: Adrian De La Hoz- John A. Vera&#10;Escenarios y arte: Yamith A. Castaño&#10;UI/UX y sonido: Laura Muñoz&#10;&#10;Creado para Game Jam Generation Colombia." name="credits-text" style="margin-bottom: 24px; white-space: normal; font-size: 20px;"/>
            <ui:Button text="← VOLVER" name="credits-back-button" style="height: 42px; font-size: 22px; color: rgb(48, 37, 29); background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; -unity-text-align: middle-left;"/>
        </ui:VisualElement>
        <ui:VisualElement name="elevator-overlay" style="flex-grow: 1; position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: hidden;">
            <ui:VisualElement name="elevator-door-left" style="flex-grow: 1; position: absolute; top: 0; bottom: 0; width: 50%; left: 0; background-image: url(&quot;project://database/Assets/Carpeta_Laura/UI/puertaizquierda.png?fileID=2800000&amp;guid=8d26d074f77e02b4aa91af61b4f2a950&amp;type=3#puertaizquierda&quot;); background-size: 112% 112%;"/>
            <ui:VisualElement name="elevator-door-right" style="flex-grow: 1; position: absolute; top: 0; bottom: 0; right: 0; width: 50%; background-image: url(&quot;project://database/Assets/Carpeta_Laura/UI/puertaderecha.png?fileID=2800000&amp;guid=99641e80c18a7e74f9760dffafc28792&amp;type=3#puertaderecha&quot;); background-size: 112% 112%;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Carpeta_Laura/UI/MainMenu.uss?fileID=7433441132597879392&amp;guid=45d6b30ef85949f4c876fff1fb51cf71&amp;type=3#MainMenu" />
    <ui:VisualElement name="menu-root" style="flex-grow: 1; justify-content: center; align-items: flex-start; background-image: url(&quot;project://database/Assets/Carpeta_Laura/UI/fondoMenu.png?fileID=2800000&amp;guid=32066eedcae4a6b4ca091a0593f9dc30&amp;type=3#fondoMenu&quot;); width: 100%; height: 100%;">
        <ui:Label text="&lt;color=#E63138&gt;CHAOS&lt;/color&gt;&#10;IN THE OFFICE" name="game-title" enable-rich-text="true" />
        <ui:VisualElement name="dossier-root" style="flex-grow: 1; position: absolute; left: 282px; top: 295px; width: 770px; height: 580px; display: flex;">
            <ui:VisualElement name="dossier-back" picking-mode="Ignore" style="flex-grow: 1; position: absolute; top: 0; left: 0; bottom: 0; right: 0; background-image: url(&quot;project://database/Assets/Carpeta_Laura/UI/Dossier/basemenu.png?fileID=2800000&amp;guid=3829e5111ac650041bf1b9fd31b69a6e&amp;type=3#basemenu&quot;); overflow: visible;" />
            <ui:VisualElement name="dossier-window" style="flex-grow: 1; position: absolute; top: 0; left: 0; right: 0; bottom: 32px; overflow: hidden; display: flex;">
                <ui:VisualElement name="menu-panel" style="background-image: url(&quot;project://database/Assets/Carpeta_Laura/UI/Dossier/papelmenu.png?fileID=2800000&amp;guid=bfc5a762361127b4d83301d92ec26455&amp;type=3#papelmenu&quot;); display: flex;" class="dossier-sheet">
                    <ui:Label text="ARCHIVO INTERNO · ACCESO RESTRINGIDO" name="file-header" class="file-header" />
                    <ui:Label name="home-title" text="INICIO" class="home-title" />
                    <ui:Button text="JUGAR" name="play-button" class="menu-button" />
                    <ui:Button text="SALIR" name="quit-button" class="menu-button" />
                </ui:VisualElement>
                <ui:VisualElement name="options-panel" style="background-image: url(&quot;project://database/Assets/Carpeta_Laura/UI/Dossier/papelmenu.png?fileID=2800000&amp;guid=bfc5a762361127b4d83301d92ec26455&amp;type=3#papelmenu&quot;); display: none;" class="dossier-sheet">
                    <ui:Label name="options-file-header" text="ARCHIVO INTERNO · ACCESO RESTRINGIDO" class="file-header" />
                    <ui:Label text="CONFIGURACIÓN" name="options-title" class="sheet-title" />
                    <ui:Slider label="VOLUMEN GENERAL" value="42" high-value="100" name="master-volume-slider" class="settings-slider" />
                    <ui:Slider label="MÚSICA" value="42" high-value="100" name="music-volume-slider" class="settings-slider" />
                    <ui:Slider label="EFECTOS" value="42" high-value="100" name="sfx-volume-slider" class="settings-slider" />
                    <ui:Slider label="SENSIBILIDAD" value="1" high-value="3" name="sensitivity-slider" low-value="0.1" class="settings-slider" />
                    <ui:Button text="← VOLVER" name="options-back-button" class="ui-feedback back-button" />
                </ui:VisualElement>
                <ui:VisualElement name="credits-panel" style="background-image: url(&quot;project://database/Assets/Carpeta_Laura/UI/Dossier/papelmenu.png?fileID=2800000&amp;guid=bfc5a762361127b4d83301d92ec26455&amp;type=3#papelmenu&quot;); display: none;" class="dossier-sheet">
                    <ui:Label name="credits-file-header" text="ARCHIVO INTERNO · ACCESO RESTRINGIDO" class="file-header" />
                    <ui:Label text="CRÉDITOS" name="credits-title" class="sheet-title" />
                    <ui:Label name="team-name" text="FUERA DE HORARIO" class="team-name" />
                    <ui:VisualElement name="credits-team-row" class="credits-team-row">

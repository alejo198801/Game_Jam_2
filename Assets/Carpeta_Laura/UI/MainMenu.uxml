                </ui:VisualElement>
                <ui:VisualElement name="options-panel" style="flex-grow: 1; position: absolute; left: 28px; bottom: auto; width: auto; padding-top: 28px; padding-right: 28px; padding-bottom: 28px; padding-left: 28px; background-color: rgba(232, 225, 207, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgba(166, 157, 137, 0); border-right-color: rgba(166, 157, 137, 0); border-top-color: rgba(166, 157, 137, 0); border-bottom-color: rgba(166, 157, 137, 0); background-image: url(&quot;project://database/Assets/Carpeta_Laura/UI/hojamarfil.png?fileID=2800000&amp;guid=16a0bf9b73fa5354797cf98c54885121&amp;type=3#hojamarfil&quot;); display: none; top: 48px; right: 28px; height: 430px;">
                    <ui:Label text="CONFIGURACIÓN" name="options-title" style="font-size: 32px; color: rgb(48, 37, 29); margin-bottom: 24px; -unity-text-align: middle-center; -unity-font-definition: url(&quot;project://database/Assets/Carpeta_Laura/Fonts/IBMPlexMono-Medium.ttf?fileID=12800000&amp;guid=18a82dc14d199cc4daddc8ce4b0a6aa7&amp;type=3#IBMPlexMono-Medium&quot;);"/>

<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Carpeta_Laura/UI/MainMenu.uss?fileID=7433441132597879392&amp;guid=45d6b30ef85949f4c876fff1fb51cf71&amp;type=3#MainMenu"/>
    <ui:VisualElement name="menu-root" style="flex-grow: 1; justify-content: center; align-items: flex-start; background-image: url(&quot;project://database/Assets/Carpeta_Laura/UI/fondoMenu.png?fileID=2800000&amp;guid=32066eedcae4a6b4ca091a0593f9dc30&amp;type=3#fondoMenu&quot;); width: 100%; height: 100%;">
        <ui:Label text="DOS MUNDOS" name="game-title" style="font-size: 80px; color: rgb(234, 216, 183); -unity-font-style: normal; margin-bottom: 0%; position: absolute; left: 19%; bottom: auto; margin-right: 0%; margin-top: 0%; margin-left: 0%; padding-bottom: 0; padding-top: 0; padding-right: 0; padding-left: 0; top: 6%; -unity-font-definition: url(&quot;project://database/Assets/Carpeta_Laura/Fonts/BarlowCondensed-Medium.ttf?fileID=12800000&amp;guid=b597c69bc3ebce04c9744069bc4c861c&amp;type=3#BarlowCondensed-Medium&quot;);"/>

                <ui:Button text="OPCIONES" name="options-tab-button" style="background-image: url(&quot;project://database/Assets/Carpeta_Laura/UI/Dossier/pesta%C3%B1aInactiva.png?fileID=2800000&amp;guid=e93e2f0cba4103348a47e7ac13564aaa&amp;type=3#pestañaInactiva&quot;);" class="dossier-tab" />
                <ui:Button text="CONTROLES" name="controls-tab-button" style="background-image: url(&quot;project://database/Assets/Carpeta_Laura/UI/Dossier/pesta%C3%B1aInactiva.png?fileID=2800000&amp;guid=e93e2f0cba4103348a47e7ac13564aaa&amp;type=3#pestañaInactiva&quot;);" class="dossier-tab" />
                <ui:Button text="CRÉDITOS" name="credits-tab-button" style="background-image: url(&quot;project://database/Assets/Carpeta_Laura/UI/Dossier/pesta%C3%B1aInactiva.png?fileID=2800000&amp;guid=e93e2f0cba4103348a47e7ac13564aaa&amp;type=3#pestañaInactiva&quot;);" class="dossier-tab" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="elevator-overlay" style="flex-grow: 1; position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: hidden; display: none;">
            <ui:VisualElement name="elevator-door-left" style="flex-grow: 1; position: absolute; top: 0; bottom: 0; width: 50%; left: 0; background-image: url(&quot;project://database/Assets/Carpeta_Laura/UI/puertaizquierda.png?fileID=2800000&amp;guid=8d26d074f77e02b4aa91af61b4f2a950&amp;type=3#puertaizquierda&quot;); background-size: 112% 112%;" />

                        </ui:VisualElement>
                        <ui:VisualElement name="art-credit" class="credit-cell">
                            <ui:Label text="ESCENARIOS Y ARTE" class="credit-role" />
                            <ui:Label text="Yamith A. Castaño" class="credit-name" />
                        </ui:VisualElement>
                        <ui:VisualElement name="ui-audio-credit" class="credit-cell">
                            <ui:Label text="UI / UX Y AUDIO" class="credit-role" />
                            <ui:Label text="Laura Muñoz" class="credit-name" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="credits-footer" text="CREADO PARA&#10;Generation Colombia · Game Jam" class="credits-footer" />
                    <ui:Button text="← VOLVER" name="credits-back-button" class="ui-feedback back-button" />
                </ui:VisualElement>
                <ui:VisualElement name="controls-panel" style="background-image: url(&quot;project://database/Assets/Carpeta_Laura/UI/Dossier/papelmenu.png?fileID=2800000&amp;guid=bfc5a762361127b4d83301d92ec26455&amp;type=3#papelmenu&quot;); display: none;" class="dossier-sheet">
                    <ui:Label name="controls-file-header" text="ARCHIVO INTERNO · ACCESO RESTRINGIDO" class="file-header" />
                    <ui:Label text="CONTROLES" name="controls-title" class="sheet-title" />

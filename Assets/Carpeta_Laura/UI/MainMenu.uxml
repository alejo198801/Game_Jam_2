                    <ui:Label text="ARCHIVO INTERNO · ACCESO RESTRINGIDO" name="file-header" style="color: rgb(87, 64, 47); font-size: 16px; margin-bottom: 24px; display: flex; height: 31px; width: 415px; white-space: normal; left: 6px; -unity-font-definition: url(&quot;project://database/Assets/Carpeta_Laura/Fonts/IBMPlexMono-Regular.ttf?fileID=12800000&amp;guid=8e85a71d98fe5f44b8bf5bea5c378e15&amp;type=3#IBMPlexMono-Regular&quot;);"/>

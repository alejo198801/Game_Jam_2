/* Estilo compartido: conserva los Name utilizados por los controladores. */
#menu-root { color: #252124; -unity-font-definition: url("project://database/Assets/Carpeta_Laura/Fonts/ShareTechMono-Regular.ttf?fileID=12800000&guid=3f862612f15ac114e8394bee9e3074e9&type=3#ShareTechMono-Regular"); }
#game-title {
 position: absolute; left: 282px; top: 6%;
 font-size: 68px; color: #E5E1DF; -unity-font-definition: url("project://database/Assets/Carpeta_Laura/Fonts/Orbitron-Bold.ttf?fileID=12800000&guid=00f15711c34432044b394f791e02c2c0&type=3#Orbitron-Bold");
 margin: 0; padding: 0; white-space: normal;
}
.dossier-sheet {
 position: absolute; left: 28px; right: 28px; top: 48px;
 height: 430px; flex-grow: 0; flex-shrink: 0;
 margin: 0; padding: 28px; background-color: rgba(0,0,0,0);
 background-size: 100% 100%;
}
.file-header { font-size: 15px; height: 22px; flex-shrink: 0; margin: 0 0 4px 0; padding: 0; }
.sheet-title {
 font-size: 30px; -unity-font-definition: url("project://database/Assets/Carpeta_Laura/Fonts/Orbitron-Bold.ttf?fileID=12800000&guid=00f15711c34432044b394f791e02c2c0&type=3#Orbitron-Bold");
 -unity-text-align: middle-left; height: 44px; flex-shrink: 0;
 margin: 0 0 8px 0; padding: 0 0 6px 0;
 border-bottom-width: 2px; border-bottom-color: #E63138;
}
.home-title { font-size: 30px; height: 50px; margin: 12px 0 22px 0; padding: 0;
 border-bottom-width: 1px; border-bottom-color: #8D795B; }
.menu-button, .back-button {
 color: #252124; background-color: rgba(0,0,0,0);
 border-width: 0; border-radius: 0; margin: 0; padding: 0 12px;
 -unity-text-align: middle-left; -unity-font-style: normal;
 -unity-font-definition: url("project://database/Assets/Carpeta_Laura/Fonts/ShareTechMono-Regular.ttf?fileID=12800000&guid=3f862612f15ac114e8394bee9e3074e9&type=3#ShareTechMono-Regular"); flex-shrink: 0;
 border-left-width: 5px; border-left-color: rgba(0,0,0,0);
}
.menu-button { height: 70px; font-size: 34px; width: 100%; }
#quit-button { margin-top: 22px; border-top-width: 1px; border-top-color: #8D795B; }
.back-button { height: 36px; font-size: 22px; margin-top: 4px; }
.menu-button:hover, .menu-button:focus, .menu-button:active,
.ui-feedback:hover, .ui-feedback:focus, .ui-feedback:active {
 color: #252124; background-color: rgba(37,33,36,0.12); border-left-color: #E63138;
}
.settings-slider { height: 46px; flex-shrink: 0; margin: 0; }
#options-panel .unity-base-slider__label {
 width: 230px; min-width: 230px; flex-shrink: 0; font-size: 23px;
 color: #252124; -unity-font-definition: url("project://database/Assets/Carpeta_Laura/Fonts/ShareTechMono-Regular.ttf?fileID=12800000&guid=3f862612f15ac114e8394bee9e3074e9&type=3#ShareTechMono-Regular"); -unity-text-align: middle-left;
}
#options-panel .unity-base-slider__tracker { height: 8px; background-color: #8D795B; border-width: 0; }
#options-panel .unity-base-slider__dragger {
 width: 16px; height: 26px; margin-top: -9px;
 background-color: #E63138; border-width: 0; border-radius: 3px;
}
#options-panel .unity-base-slider__dragger-border { border-width: 0; background-color: rgba(0,0,0,0); }
#options-panel .unity-base-slider:focus .unity-base-slider__label { color: #E63138; }
.control-row { flex-direction: row; align-items: center; height: 64px; flex-shrink: 0;
 border-bottom-width: 1px; border-bottom-color: #8D795B; }
.control-icon { width: 180px; height: 64px; flex-shrink: 0;
 -unity-background-scale-mode: scale-to-fit; background-color: rgba(0,0,0,0); }
.control-description { font-size: 26px; height: 52px; margin: 0 0 0 12px;
 padding: 0 0 0 20px; border-left-width: 1px; border-left-color: #8D795B;
 -unity-text-align: middle-left; white-space: normal; flex-grow: 1; }
.team-name { -unity-font-definition: url("project://database/Assets/Carpeta_Laura/Fonts/Orbitron-Bold.ttf?fileID=12800000&guid=00f15711c34432044b394f791e02c2c0&type=3#Orbitron-Bold"); font-size: 28px; height: 38px;
 margin: 0 0 4px 0; padding: 0; -unity-text-align: middle-left; }
.credits-team-row { flex-direction: row; height: 90px; flex-shrink: 0;
 border-top-width: 1px; border-bottom-width: 1px; border-top-color: #8D795B; border-bottom-color: #8D795B; }
.credit-cell { width: 33.33%; padding: 10px 8px 0 8px; }
.credit-role { font-size: 17px; color: #252124; border-left-width: 3px;
 border-left-color: #E63138; padding-left: 6px; margin: 0 0 8px 0; white-space: normal; }
.credit-name { font-size: 19px; margin: 0; padding: 0; white-space: normal; }
.credits-footer { height: 42px; font-size: 18px; margin: 8px 0 0 0; padding: 0; white-space: normal; }
.dossier-tab { width: 170px; height: 64px; flex-grow: 0; flex-shrink: 0;
 margin: 0; padding: 0; border-width: 0; background-color: rgba(0,0,0,0);
 -unity-font-definition: url("project://database/Assets/Carpeta_Laura/Fonts/Orbitron-Bold.ttf?fileID=12800000&guid=00f15711c34432044b394f791e02c2c0&type=3#Orbitron-Bold"); font-size: 16px; color: #252124;
 -unity-text-align: middle-center;
}

/* Solo Pausa: el menú principal conserva su distribución. */
.pause-menu .pause-tabs .dossier-tab { width: 238px; }
.pause-menu #pause-panel #resume-button { margin-top: 16px; }
.pause-menu #main-menu-button { margin-top: 12px; border-top-width: 1px; border-top-color: #8D795B; }
.pause-menu .pause-hint { margin: 16px 0 0 6px; padding: 0; font-size: 20px; color: #252124; }

:root {
}

.menu-button {
    height: 64px;
    margin-left: 0;
    margin-bottom: 0;
    font-size: 28px;
    color: rgb(41, 37, 30);
    background-color: rgba(32, 37, 43, 0);
    -unity-text-align: middle-left;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-left-color: rgba(149, 149, 149, 0);
    border-right-color: rgba(149, 149, 149, 0);
    border-top-color: rgba(149, 149, 149, 0);
    border-bottom-color: rgba(149, 149, 149, 0);
    padding-bottom: 0;
    width: 100%;
    flex-shrink: 0;
    padding-left: 8px;
    -unity-font-style: normal;
    -unity-font-definition: url("project://database/Assets/Carpeta_Laura/Fonts/IBMPlexMono-Medium.ttf?fileID=12800000&guid=18a82dc14d199cc4daddc8ce4b0a6aa7&type=3#IBMPlexMono-Medium");
}

.menu-button:hover {
    color: rgb(114, 45, 37);
    background-color: rgba(70, 40, 20, 0.118);
}

.menu-button:active {
    background-color: rgba(70, 40, 20, 0.118);
    color: rgb(66, 27, 22);
}

#options-panel .unity-base-slider__tracker {
    background-color: rgb(139, 113, 85);
    height: 3px;
}

#options-panel .unity-base-slider__dragger {
    background-color: rgb(114, 45, 37);
    height: 20px;
    width: 12px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    border-bottom-left-radius: 2px;
}

#options-panel .unity-base-slider:focus .unity-base-slider__label {
    color: rgb(114, 45, 37);
}

#options-panel .unity-base-slider:focus .unity-base-slider__dragger {
    border-left-color: rgb(114, 45, 37);
    border-right-color: rgb(114, 45, 37);
    border-top-color: rgb(114, 45, 37);
    border-bottom-color: rgb(114, 45, 37);
}

#menu-panel .menu-button {
    border-bottom-width: 1px;
    border-bottom-color: rgb(148, 116, 72);
}

#options-panel .unity-base-slider__label {
    font-size: 20px;
    width: 230px;
    min-width: 230px;
    flex-shrink: 0;
    -unity-font-definition: url("project://database/Assets/Carpeta_Laura/Fonts/IBMPlexMono-Regular.ttf?fileID=12800000&guid=8e85a71d98fe5f44b8bf5bea5c378e15&type=3#IBMPlexMono-Regular");
}

.ui-feedback:hover {
    color: rgb(114, 45, 37);
    background-color: rgba(70, 40, 20, 0.255);
}

.ui-feedback:focus {
    color: rgb(114, 45, 37);
    background-color: rgba(70, 40, 20, 0.255);
}

.ui-feedback {
    color: rgb(48, 37, 29);
    background-color: rgba(70, 40, 20, 0);
}

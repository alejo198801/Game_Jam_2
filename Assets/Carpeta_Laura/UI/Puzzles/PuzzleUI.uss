:root {
}

.defeat-button:hover {
    color: rgb(229, 225, 223);
    background-color: rgb(230, 49, 56);
}

.defeat-button:focus {
}

.defeat-button:active {
    color: rgb(229, 225, 223);
    background-color: rgb(37, 33, 36);
}

.defeat-button {
}

.victory-button {
    color: #252124;
    background-color: transparent;
    background-image: none;

    border-width: 0;
    border-left-width: 6px;
    border-left-color: transparent;
    border-radius: 0;
}

.victory-button:hover,
.victory-button:focus {
    color: #252124;
    background-color: rgba(37, 33, 36, 0.14);
    border-left-color: #E63138;
}

.victory-button:active {
    background-color: rgba(37, 33, 36, 0.24);
    border-left-color: #E63138;
}
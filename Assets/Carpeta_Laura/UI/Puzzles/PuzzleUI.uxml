                <ui:Button text="8" name="digit-8-button" style="color: rgb(229, 225, 223); font-size: 28px; background-color: rgb(37, 33, 36); margin-top: 4px; margin-bottom: 4px; height: 64px; flex-grow: 1; flex-basis: 0;"/>
                <ui:Button text="9" name="digit-9-button" style="color: rgb(229, 225, 223); background-color: rgb(37, 33, 36); font-size: 28px; flex-basis: 0; flex-grow: 1; height: 64px; margin-top: 4px; margin-bottom: 4px;"/>

    <ui:VisualElement name="puzzle-root" style="flex-grow: 1; position: absolute; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.549); top: 0; left: 0; bottom: 0; right: 0; display: none;">
        <ui:VisualElement name="keypad-panel" style="flex-grow: 0; width: 460px; padding-top: 28px; padding-right: 28px; padding-bottom: 28px; padding-left: 28px; background-color: rgb(20, 18, 22); -unity-font-definition: url(&quot;project://database/Assets/Carpeta_Laura/Fonts/ShareTechMono-Regular.ttf?fileID=12800000&amp;guid=3f862612f15ac114e8394bee9e3074e9&amp;type=3#ShareTechMono-Regular&quot;); flex-shrink: 0;">
